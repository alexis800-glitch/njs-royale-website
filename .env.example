# NJS Royale — environment variables (names only; never commit real values).
# Values live in Vercel (Preview and Production) and are injected at build/run time.

# Meta dataset (Pixel) ID. Public by design: it is exposed to the browser.
# Tracking is disabled entirely when this is unset.
NEXT_PUBLIC_META_PIXEL_ID=

# Meta Conversions API access token. Server-side only — never expose to the browser,
# never log. Used from Phase 2 onwards (no CAPI calls are made yet).
META_CAPI_ACCESS_TOKEN=

# Optional. Routes CAPI events to Meta's Test Events tool while testing on Preview.
# Leave unset in Production.
META_CAPI_TEST_EVENT_CODE=

# ── Registration storage ────────────────────────────────────────────────────────
# Postgres (Neon) connection string for the registrations table. Server-side only.
# POSTGRES_URL and DATABASE_URL_UNPOOLED are accepted as alternatives. Without any
# of them the registration endpoint refuses a submission rather than discarding it.
#
# Set MANUALLY in Vercel, per environment. The Neon-Vercel integration is
# deliberately disconnected: its automatic preview branching injected Git
# branch-scoped copies of this variable that silently overrode the configured
# Preview database, and Neon branches clone the parent branch's DATA -- the parent
# being Production. Do not reconnect it without reading
# docs/registration-meta-verification.md. Use the POOLED connection string for the
# application and the DIRECT (unpooled) one for migrations.
DATABASE_URL=

# Salt for the one-way hash of a registrant's IP address, stored only so that rate
# limiting works across serverless instances. Use a long random string; at least
# 16 characters, and 64 hex characters is a good default.
#
# If this is missing or too short, NO hash is stored and rate limiting is skipped,
# and the condition is logged once per process. That is deliberate: an unsalted
# SHA-256 of an IPv4 address can be reversed by exhausting the address space in
# seconds, so it would not be a pseudonym at all. Registrations still succeed.
REGISTRATION_IP_SALT=
